<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>HalleBot Platformer</title>
</head>
<body id="body">
  <canvas id="canvas" width="1400" height="750"></canvas>

  <!-- Game images. They are embedded as data URLs so JSFiddle does not need an asset folder. -->
  <img id="cannon" src="data:image/png;base64," alt="">
  <img id="player" src="data:image/webp;base64," alt="">
  <img id="projectile" src="data:image/png;base64," alt="">
  <img id="database" src="data:image/png;base64," alt="">
  <img id="diamond" src="data:image/png;base64," alt="">
  <img id="grace" src="data:image/png;base64," alt="">
  <img id="kennedi" src="data:image/png;base64," alt="">
  <img id="max" src="data:image/png;base64," alt="">
  <img id="steve" src="data:image/png;base64," alt="">
</body>
</html>
